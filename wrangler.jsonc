{
  // Static-assets Worker: Cloudflare runs `npm run build`, then `npx wrangler deploy` uploads dist.
  "name": "my-app-ai",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes such as /auth/callback/google.
    "not_found_handling": "single-page-application"
  }
}

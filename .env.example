# Where the frontend finds the API. Blank in development: Vite proxies /api to
# http://127.0.0.1:8000 (vite.config.ts). For the hosted build (Cloudflare Pages
# > Settings > Variables), set the Tailscale Funnel address, e.g.:
# VITE_API_BASE_URL=https://my-laptop.tail1234.ts.net/api/v1
VITE_API_BASE_URL=
